# Source distributions carry code, docs and tests only. Local state and secrets never ship.
include README.md AGENTS.md LICENSE
recursive-include docs *.md
recursive-include config *.example.json
recursive-include tests *.py *.mid
prune workspace
recursive-include scripts *.py
global-exclude .env .env.* *.sqlite3 *.drp __pycache__ *.py[cod]
exclude config/mcp.json config/config.json
